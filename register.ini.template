; =============================================================================
;  ملف الإعدادات — برنامج حجز كرامة
; =============================================================================
;  • عدّل القيم واحفظ الملف (Ctrl+S) ثم شغّل KaramaStart.exe أو TestTelegram.exe
;  • يمكنك تغيير تيليجرام في أي وقت — التعديل يُطبَّق في التشغيلة التالية
;  • لا تشارك هذا الملف مع أحد (يحتوي على توكن البوت السري)
; =============================================================================

[TELEGRAM]
; توكن البوت من @BotFather  (مثال: 1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxx)
BOT_TOKEN = ضع_توكن_البوت_هنا

; القناة أو المجموعة:
;   - قناة عامة: @اسم_القناة
;   - قناة/مجموعة خاصة: -1001234567890  (من @userinfobot أو إعدادات القناة)
CHANNEL = @اسم_القناة_او_-100xxxxxxxxxx

; رابط يظهر في رسالة النجاح — {req_id} = رقم الطلب من الموقع (لا تحذفه)
VIEW_URL = http://www.smcegy.com/Karama/ViewAll.aspx?reqId={req_id}

; ---------------------------------------------------------------------------
;  إعدادات إضافية (اختياري)
; ---------------------------------------------------------------------------
[SETTINGS]
; ثوانٍ بين الخطوات (للموقع البطيء زِد الرقم)
SLEEP = 10

; مجلد ملفات الحالات (.xml) — ضع كل الملفات هنا (عدد غير محدود)
CASES_FOLDER = register_cases

; مجلد الحالات المنتهية بعد الحجز الناجح
FINISHED_FOLDER = register_finished

; مجلد صور الأخطاء (الحالات الفاشلة تبقى في register_cases)
ERROR_IMAGES_FOLDER = error_images

; عدد الحالات المتزامنة (1–6)
THREADS_COUNT = 4

; مراقبة مجلد register_cases بعد انتهاء الدفعة (ثوانٍ)
WATCH_POLL_SECONDS = 3
; إغلاق تلقائي بعد X ثانية بدون ملفات جديدة (0 = إغلاق فوري بعد الدفعة)
WATCH_IDLE_SECONDS = 120

; ---------------------------------------------------------------------------
;  مفاتيح قديمة (ما زالت تعمل إذا فضّلت قسم SETTINGS فقط):
;  TELEGRAM_BOT = نفس BOT_TOKEN
;  TELEGRAM_CHANNEL = نفس CHANNEL
; -----------------------------------------------------------------------------
